# ─── Servidor ───
PORT=3000
NODE_ENV=production

# ─── PostgreSQL (Railway) ───
# En el servicio backend de Railway, agrega DATABASE_URL (internal) o referencia:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Desde tu PC (migraciones locales): usa la Public URL de Railway, no *.railway.internal
DATABASE_URL=postgresql://user:password@postgres.railway.internal:5432/railway
# Alternativa manual (local):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=zyra
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=true

# ─── Auth ───
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

# ─── Cloudinary (subida de fotos/videos) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional (alternativa a las 3 vars anteriores):
# CLOUDINARY_URL=cloudinary://key:secret@cloud_name
CLOUDINARY_FOLDER=ZyraEnterprise
CLOUDINARY_UPLOAD_PRESET=
