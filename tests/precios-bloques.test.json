  "casosDeError": {
    "error1_bloquesNoEsArray": {
      "descripcion": "Error: bloques no es un array",
      "body": {
        "bloques": "esto no es un array"
      },
      "errorEsperado": "El campo \"bloques\" debe ser un array",
      "codigoEsperado": 400
    },
    "error2_bloquesSinDias": {
      "descripcion": "Error: bloque sin días",
      "body": {
        "bloques": [
          {
            "dias": [],
            "horarios": [
              {
                "hora_inicio": "08:00",
                "hora_fin": "22:00",
                "precio_hora": 60000
              }
            ]
          }
        ]
      },
      "errorEsperado": "debe contener un array \"dias\" con al menos un día",
      "codigoEsperado": 400
    },
    "error3_etiquetaDiaInvalida": {
      "descripcion": "Error: etiqueta de día inválida",
      "body": {
        "bloques": [
          {
            "dias": ["Lun", "Mar"],
            "horarios": [
              {
                "hora_inicio": "08:00",
                "hora_fin": "22:00",
                "precio_hora": 60000
              }
            ]
          }
        ]
      },
      "errorEsperado": "etiqueta de día \"Lun\" no es válida",
      "codigoEsperado": 400
    },
    "error4_formatoHoraInvalido": {
      "descripcion": "Error: formato de hora inválido",
      "body": {
        "bloques": [
          {
            "dias": ["Lu"],
            "horarios": [
              {
                "hora_inicio": "8:00",
                "hora_fin": "22:00",
                "precio_hora": 60000
              }
            ]
          }
        ]
      },
      "errorEsperado": "debe estar en formato HH:MM",
      "codigoEsperado": 400
    },
    "error5_precioNegativo": {
      "descripcion": "Error: precio negativo",
      "body": {
        "bloques": [
          {
            "dias": ["Lu"],
            "horarios": [
              {
                "hora_inicio": "08:00",
                "hora_fin": "22:00",
