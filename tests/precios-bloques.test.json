      "errorEsperado": "debe contener un array \"horarios\" con al menos una franja",
      "codigoEsperado": 400
    }
  },
  "instrucciones": {
    "como_usar": [
      "1. Reemplaza {CANCHA_ID} con el ID de una cancha real en tu BD",
      "2. Para endpoints protegidos (PUT), reemplaza {TOKEN} con un token JWT válido",
      "3. Usa estos JSONs directamente en Postman/Insomnia o cURL",
      "4. Después de un PUT exitoso, ejecuta el GET para verificar el agrupamiento"
    ],
    "ejemplo_curl_get": "curl -X GET http://localhost:3000/api/canchas/1/precios",
    "ejemplo_curl_put": "curl -X PUT http://localhost:3000/api/canchas/1/precios -H 'Content-Type: application/json' -H 'Authorization: Bearer {TOKEN}' -d @caso1_configuracionSimple.json"
  }
}
