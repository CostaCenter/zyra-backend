# Copia estas variables en Railway → servicio BACKEND (no solo Postgres) → Variables

# Opción A (recomendada): Reference → Postgres → DATABASE_URL
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Opción B: pegar la URL internal manualmente
# DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway

NODE_ENV=production
JWT_SECRET=tu-secreto-jwt-produccion
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ZyraEnterprise
